#!/bin/bash

if [ "$EUID" -ne 0 ]; then
    echo "Please run application as root" >> /var/log/vdtg-rmm.log 2>&1
    exit 1
fi

# --- CVE-2026-31431 kernel vulnerability check ---
# Markeer kernel als kwetsbaar als:
# - Kernel is ouder dan 1 april 2026 (upstream fix)
# - Of behoort tot bekende kwetsbare reeksen (5.x, 6.0–6.18, vroege 7.0)
# Veilig:
# - 5.15.204+, 6.12.85+, 6.18.12/6.18.22+, 6.19.12+, 7.0+

# Kernel versie ophalen
kernel_version=$(uname -r | cut -d '-' -f1)
kernel_major=$(echo "$kernel_version" | cut -d '.' -f1)
kernel_minor=$(echo "$kernel_version" | cut -d '.' -f2)
kernel_patch=$(echo "$kernel_version" | cut -d '.' -f3)

# Kernel build datum ophalen
kernel_build_date=$(uname -v | grep -oE '[A-Za-z]{3} [A-Za-z]{3} [ 0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [A-Za-z]{3} [0-9]{4}')
kernel_build_epoch=$(date -d "$kernel_build_date" +%s 2>/dev/null)
fix_epoch=$(date -d "2026-04-01" +%s)

# Functie om te vergelijken of versie1 >= versie2
version_ge() {
    [ "$1" = "$2" ] && return 0
    local IFS=.
    local i ver1=($1) ver2=($2)
    # Vul met nullen tot gelijke lengte
    for ((i=${#ver1[@]}; i<${#ver2[@]}; i++)); do ver1[i]=0; done
    for ((i=0; i<${#ver1[@]}; i++)); do
        if [[ -z ${ver2[i]} ]]; then
            # bv. 6.19 > 6.19.0
            if ((10#${ver1[i]} > 0)); then return 0; fi
        elif ((10#${ver1[i]} > 10#${ver2[i]})); then
            return 0
        elif ((10#${ver1[i]} < 10#${ver2[i]})); then
            return 1
        fi
    done
    return 0
}

# Kwetsbaarheidslogica
vulnerable_kernel=false
safe=false

case "$kernel_major.$kernel_minor" in
    5.*)
        # Alleen 5.15.204+ is veilig
        if version_ge "$kernel_version" "5.15.204"; then
            safe=true
        else
            vulnerable_kernel=true
        fi
        ;;
    6.0|6.1|6.2|6.3|6.4|6.5|6.6|6.7|6.8|6.9|6.10|6.11)
        vulnerable_kernel=true
        ;;
    6.12)
        if version_ge "$kernel_version" "6.12.85"; then
            safe=true
        else
            vulnerable_kernel=true
        fi
        ;;
    6.18)
        # 6.18.12 en 6.18.22 zijn veilig, alles lager kwetsbaar
        if version_ge "$kernel_version" "6.18.22"; then
            safe=true
        elif version_ge "$kernel_version" "6.18.12"; then
            safe=true
        else
            vulnerable_kernel=true
        fi
        ;;
    6.19)
        if version_ge "$kernel_version" "6.19.12"; then
            safe=true
        else
            vulnerable_kernel=true
        fi
        ;;
    7.0|7.*)
        safe=true
        ;;
    *)
        # Onbekende kernelreeks, check build datum
        if [ -n "$kernel_build_epoch" ] && [ "$kernel_build_epoch" -lt "$fix_epoch" ]; then
            vulnerable_kernel=true
        fi
        ;;
esac

if [ "$vulnerable_kernel" = true ] && [ "$safe" != true ]; then
    echo "[WAARSCHUWING] Deze kernel ($kernel_version) is kwetsbaar voor CVE-2026-31431. Update naar een veilige kernelversie." >> /var/log/vdtg-rmm.log 2>&1

fi

# Check if /opt/vdtg-rmm application folder exists else stop code execution
if [ -d "/opt/vdtg-rmm" ]; then

    cd /opt/vdtg-rmm >> /var/log/vdtg-rmm.log 2>&1

    # Ensure daemon is executable
    if [ ! -x /opt/vdtg-rmm/vdtg-rmm-daemon ]; then
        chmod +x /opt/vdtg-rmm/vdtg-rmm-daemon >> /var/log/vdtg-rmm.log 2>&1
    fi

    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        # Ensure cron is installed and enabled
        if ! dpkg -l | grep -q cron; then
            apt install -y cron >> /var/log/vdtg-rmm.log 2>&1
        fi
        systemctl enable --now cron >> /var/log/vdtg-rmm.log 2>&1

        # Add vdtg-rmm-daemon to crontab if not already present (every 6 hours)
        if ! crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            (crontab -l 2>/dev/null; echo "0 */6 * * * /opt/vdtg-rmm/vdtg-rmm-daemon") | crontab - >> /var/log/vdtg-rmm.log 2>&1
        fi
    else
        # Remove vdtg-rmm-daemon from crontab if present
        if crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            crontab -l 2>/dev/null | grep -v "/opt/vdtg-rmm/vdtg-rmm-daemon" | crontab - >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    # Config file logic
    if [ ! -f /opt/vdtg-rmm/vdtg-rmm.config ]; then
        cp /opt/vdtg-rmm/vdtg-rmm.config.example /opt/vdtg-rmm/vdtg-rmm.config >> /var/log/vdtg-rmm.log 2>&1
    else
        # Vul lege values aan
        while IFS= read -r line; do
            if [[ ! $line == \#* ]] && [ ! -z "$line" ]; then
                key=$(echo $line | awk -F'=' '{print $1}')
                value=$(echo $line | awk -F'=' '{print $2}')
                if [ -z "$value" ]; then
                    default_value=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config.example | grep -i "^$key=" | awk -F'=' '{print $2}')
                    sed -i "s/^$key=/$key=$default_value/" /opt/vdtg-rmm/vdtg-rmm.config >> /var/log/vdtg-rmm.log 2>&1
                fi
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config

        # Voeg ontbrekende regels (inclusief comments) toe
        while IFS= read -r line; do
            # Check of regel exact voorkomt in config
            if ! grep -Fxq "$line" /opt/vdtg-rmm/vdtg-rmm.config; then
                echo "$line" >> /opt/vdtg-rmm/vdtg-rmm.config
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config.example
    fi

    # Detect OS and version, then select correct sources.list file
    OS_ID="$(. /etc/os-release && echo "$ID")"
    OS_VER="$(. /etc/os-release && echo "$VERSION_ID")"

    # Detect Proxmox by checking for /etc/pve or /etc/proxmox-ve or installed package
    if [ -d "/etc/pve" ] || [ -f "/etc/proxmox-ve" ] || dpkg -l | grep -q "proxmox-ve"; then
        OS_ID="proxmox"
        # Try to get Proxmox version from /etc/pve/version (first digit)
        if [ -f "/etc/pve/version" ]; then
            PROXMOX_VER=$(head -n1 /etc/pve/version | grep -oE '^[0-9]+')
        fi
        # If not found, try dpkg-query proxmox-ve
        if [ -z "$PROXMOX_VER" ]; then
            PROXMOX_VER=$(dpkg-query -W -f='${Version}' proxmox-ve 2>/dev/null | grep -oE '^[0-9]+')
        fi
        # Fallback to 8 if still not found
        if [ -z "$PROXMOX_VER" ]; then
            PROXMOX_VER="8"
        fi
        # Set OS_VER to Proxmox version 
        OS_VER="$PROXMOX_VER"
        # Set sources.list paths for Proxmox
        SRC_FILE="/opt/vdtg-rmm/sources/proxmox/${PROXMOX_VER}/sources.list"
        DST_FILE="/etc/apt/sources.list"
    elif [ "$OS_ID" = "debian" ]; then
        # Check if /etc/apt/sources.list or /etc/apt/sources.list.d/debian.sources is used.
        if [ -f "/etc/apt/sources.list.d/debian.sources" ]; then
            SRC_FILE="/opt/vdtg-rmm/sources/debian/${OS_VER}/debian.sources"
            DST_FILE="/etc/apt/sources.list.d/debian.sources"
        else
            SRC_FILE="/opt/vdtg-rmm/sources/debian/${OS_VER}/sources.list"
            DST_FILE="/etc/apt/sources.list"
        fi
    elif [ "$OS_ID" = "linuxmint" ]; then
        # Set sources.list paths for LMDE (Linux Mint Debian Edition)
        SRC_FILE="/opt/vdtg-rmm/sources/lmde/${OS_VER}/official-package-repositories.list"
        DST_FILE="/etc/apt/sources.list.d/official-package-repositories.list"
    else
        # Unsupported OS, skip sources.list setup
        SRC_FILE=""
        DST_FILE=""
        echo "Unsupported OS: $OS_ID. Skipping sources.list setup. Please contact support to add compatibility for your OS." >> /var/log/vdtg-rmm.log 2>&1
    fi

    install_vdtg_mirror=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_vdtg_mirror' | awk -F'=' '{print $2}')
    # If the config setting to install the VDTG mirror is true, copy the selected sources.list file to the correct location based on detected OS and version. This will set the system to use the VDTG mirror for package updates and installations, which can improve speed and reliability.
    if [ "$install_vdtg_mirror" == "true" ]; then
        
        # If source file exists and is different from destination, copy it
        if [ -n "$SRC_FILE" ] && [ -f "$SRC_FILE" ]; then
            # Only copy if destination file doesn't exist or is different from source
            if [ ! -f "$DST_FILE" ] || ! cmp -s "$SRC_FILE" "$DST_FILE"; then
                cp "$SRC_FILE" "$DST_FILE" >> /var/log/vdtg-rmm.log 2>&1
                echo "VDTG mirror sources.list installed, updating package lists..." >> /var/log/vdtg-rmm.log 2>&1
                apt clean >> /var/log/vdtg-rmm.log 2>&1
                apt update >> /var/log/vdtg-rmm.log 2>&1
            fi
        fi
    fi

    # Check config for cron_enable and update_auto settings, if cron_enable is true disable cron before updates and re-enable after updates
    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1false/' /opt/vdtg-rmm/vdtg-rmm.config >> /var/log/vdtg-rmm.log 2>&1
    fi

    update_auto=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'update_auto' | awk -F'=' '{print $2}')
    if [ "$update_auto" == "true" ]; then
        # Refresh repositories and update system
        apt clean >> /var/log/vdtg-rmm.log 2>&1
        apt update >> /var/log/vdtg-rmm.log 2>&1

        # If OS is Proxmox, use apt dist-upgrade to ensure kernel and proxmox packages are also updated, otherwise use apt upgrade.
        if [ "$OS_ID" == "proxmox" ]; then
            apt dist-upgrade -y >> /var/log/vdtg-rmm.log 2>&1
        else
            apt upgrade -y >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    # After updates, re-enable cron if it was enabled before
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1true/' /opt/vdtg-rmm/vdtg-rmm.config >> /var/log/vdtg-rmm.log 2>&1
    fi

    # Locale setup, first check if OS is not Proxmox since Proxmox has its own locale settings and changing them can cause issues with the Proxmox web interface. If not Proxmox, check config for locale setting and install locales package if not already installed, then set system locale based on config value (nl or en).
    if [ "$OS_ID" != "proxmox" ]; then
        locale=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'locale' | awk -F'=' '{print $2}')
        if [ -n "$locale" ]; then
            if ! dpkg -l | grep -q "locales"; then
                apt install -y locales >> /var/log/vdtg-rmm.log 2>&1
            fi
            # Bepaal gewenste locale waarden
            if [ "$locale" == "nl" ]; then
                desired_LANG="nl_NL.UTF-8"
                desired_LC_MESSAGES="nl_NL.UTF-8"
                # Uncomment nl_NL.UTF-8 UTF-8 in /etc/locale.gen indien nodig
                sed -i 's/^# *\(nl_NL\.UTF-8 UTF-8\)/\1/' /etc/locale.gen >> /var/log/vdtg-rmm.log 2>&1
            elif [ "$locale" == "en" ]; then
                desired_LANG="en_US.UTF-8"
                desired_LC_MESSAGES="POSIX"
                # Uncomment en_US.UTF-8 UTF-8 in /etc/locale.gen indien nodig
                sed -i 's/^# *\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen >> /var/log/vdtg-rmm.log 2>&1
            else
                desired_LANG=""
                desired_LC_MESSAGES=""
            fi

            # Huidige locale ophalen
            current_LANG=$(locale | grep '^LANG=' | awk -F'=' '{print $2}')
            current_LC_MESSAGES=$(locale | grep '^LC_MESSAGES=' | awk -F'=' '{print $2}')

            # Alleen wijzigen als huidig anders is dan gewenst
            if [ -n "$desired_LANG" ] && [ "$current_LANG" != "$desired_LANG" -o "$current_LC_MESSAGES" != "$desired_LC_MESSAGES" ]; then
                update-locale LANG=$desired_LANG LC_MESSAGES=$desired_LC_MESSAGES >> /var/log/vdtg-rmm.log 2>&1
                locale-gen >> /var/log/vdtg-rmm.log 2>&1
                touch /opt/vdtg-rmm/reboot-required
            fi
        fi
    fi

    install_git=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_git' | awk -F'=' '{print $2}')
    if [ "$install_git" == "true" ]; then
        if ! dpkg -l | grep -q git; then
            apt install -y git >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_net_tools=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_net_tools' | awk -F'=' '{print $2}')
    if [ "$install_net_tools" == "true" ]; then
        if ! dpkg -l | grep -q net-tools; then
            apt install -y net-tools >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_iputils_ping=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_iputils_ping' | awk -F'=' '{print $2}')
    if [ "$install_iputils_ping" == "true" ]; then
        if ! dpkg -l | grep -q iputils-ping; then
            apt install -y iputils-ping >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_steamcmd=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_steamcmd' | awk -F'=' '{print $2}')
    if [ "$install_steamcmd" == "true" ]; then
        if ! dpkg -l | grep -q steamcmd; then
            # Install required 32-bit libraries for SteamCMD
            if ! dpkg -l | grep -q lib32gcc-s1; then
                apt install -y lib32gcc-s1 >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Create steamcmd user if not exists
            if ! id -u steamcmd >/dev/null 2>&1; then
                useradd -m -s /bin/bash steamcmd
            fi

            # Create steamcmd folder in home directory of steamcmd user and set ownership
            mkdir -p /home/steamcmd/steamcmd >> /var/log/vdtg-rmm.log 2>&1
            chown -R steamcmd:steamcmd /home/steamcmd >> /var/log/vdtg-rmm.log 2>&1

            # Check if sudo is installed, if not install it
            if ! dpkg -l | grep -q sudo; then
                apt install -y sudo >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Download and extract SteamCMD as the steamcmd user to ensure correct permissions, then run it once to create necessary folders
            sudo -u steamcmd bash -c "cd /home/steamcmd/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
            sudo -u steamcmd bash -c "cd /home/steamcmd/steamcmd && tar -xvzf steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
            sudo -u steamcmd /home/steamcmd/steamcmd/steamcmd.sh +quit >> /var/log/vdtg-rmm.log 2>&1

        fi
    fi

    install_runescape_dragonwilds_dedicated_server=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_runescape_dragonwilds_dedicated_server' | awk -F'=' '{print $2}')
    if [ "$install_runescape_dragonwilds_dedicated_server" == "true" ]; then
        if ! dpkg -l | grep -q runescape-dragonwilds-dedicated-server; then
            
            # Create dragonwilds user if not exists
            if ! id -u dragonwilds >/dev/null 2>&1; then
                useradd -m -s /bin/bash dragonwilds >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Create necessary folders for dragonwilds user if not exists
            if [ ! -d "/home/dragonwilds/rs_server" ]; then
                mkdir -p /home/dragonwilds/rs_server >> /var/log/vdtg-rmm.log 2>&1
                chown dragonwilds:dragonwilds /home/dragonwilds/rs_server >> /var/log/vdtg-rmm.log 2>&1
            fi
            if [ ! -d "/home/dragonwilds/dragonwilds_backups" ]; then
                mkdir -p /home/dragonwilds/dragonwilds_backups >> /var/log/vdtg-rmm.log 2>&1
                chown dragonwilds:dragonwilds /home/dragonwilds/dragonwilds_backups >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Install SteamCMD if not already installed, but only if the steamcmd.sh file doesn't exist in the expected location.
            if [ ! -f "/home/dragonwilds/steamcmd/steamcmd.sh" ]; then

                # Install required 32-bit libraries for SteamCMD
                if ! dpkg -l | grep -q lib32gcc-s1; then
                    apt install -y lib32gcc-s1 >> /var/log/vdtg-rmm.log 2>&1
                fi

                # Create steamcmd folder in home directory of dragonwilds user and set ownership
                mkdir -p /home/dragonwilds/steamcmd >> /var/log/vdtg-rmm.log 2>&1
                chown -R dragonwilds:dragonwilds /home/dragonwilds >> /var/log/vdtg-rmm.log 2>&1

                # Check if sudo is installed, if not install it
                if ! dpkg -l | grep -q sudo; then
                    apt install -y sudo >> /var/log/vdtg-rmm.log 2>&1
                fi
                
                # Download and extract SteamCMD as the dragonwilds user to ensure correct permissions, then run it once to create necessary folders
                sudo -u dragonwilds bash -c "cd /home/dragonwilds/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
                sudo -u dragonwilds bash -c "cd /home/dragonwilds/steamcmd && tar -xvzf steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
                sudo -u dragonwilds /home/dragonwilds/steamcmd/steamcmd.sh +quit >> /var/log/vdtg-rmm.log 2>&1

                # Use SteamCMD to download the RuneScape Dragonwilds Dedicated Server files, install them in the correct folder with the correct user permissions
                sudo -u dragonwilds /home/dragonwilds/steamcmd/steamcmd.sh +force_install_dir /home/dragonwilds/rs_server +login anonymous +app_update 4019830 +quit >> /var/log/vdtg-rmm.log 2>&1

            fi

            # Create systemd service for RuneScape Dragonwilds Dedicated Server, but only if it doesn't already exist. The service file is selected based on the detected OS and version to ensure compatibility.
            SERVICE_SRC="/opt/vdtg-rmm/systemctl/${OS_ID}/${OS_VER}/runescape-dragonwilds_dedicated-server.service"
            SERVICE_DST="/etc/systemd/system/runescape-dragonwilds_dedicated-server.service"
            if [ -f "$SERVICE_SRC" ]; then
                cp "$SERVICE_SRC" "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                chown root:root "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                chmod 644 "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                systemctl daemon-reload >> /var/log/vdtg-rmm.log 2>&1
                systemctl enable runescape-dragonwilds-dedicated-server >> /var/log/vdtg-rmm.log 2>&1
                echo "RuneScape Dragonwilds Dedicated Server service installed, please edit /home/dragonwilds/rs_server/RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini to configure the server and then start the service with: systemctl start runescape-dragonwilds-dedicated-server" >> /var/log/vdtg-rmm.log 2>&1
            else
                echo "Service file for RuneScape Dragonwilds Dedicated Server not found for OS: $OS_ID version: $OS_VER. Please contact support to add compatibility for your OS version." >> /var/log/vdtg-rmm.log 2>&1
            fi

        fi
    fi

    install_eco_dedicated_server=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_eco_dedicated_server' | awk -F'=' '{print $2}')
    if [ "$install_eco_dedicated_server" == "true" ]; then
        if ! dpkg -l | grep -q eco-dedicated-server; then

            # Create eco user if not exists
            if ! id -u eco >/dev/null 2>&1; then
                useradd -m -s /bin/bash eco >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Create necessary folders for eco user if not exists
            if [ ! -d "/home/eco/eco_server" ]; then
                mkdir -p /home/eco/eco_server >> /var/log/vdtg-rmm.log 2>&1
                chown eco:eco /home/eco/eco_server >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Install SteamCMD if not already installed, but only if the steamcmd.sh file doesn't exist in the expected location.
            if [ ! -f "/home/eco/steamcmd/steamcmd.sh" ]; then

                # Install required 32-bit libraries for SteamCMD
                if ! dpkg -l | grep -q lib32gcc-s1; then
                    apt install -y lib32gcc-s1 >> /var/log/vdtg-rmm.log 2>&1
                fi

                # Create steamcmd folder in home directory of eco user and set ownership
                mkdir -p /home/eco/steamcmd >> /var/log/vdtg-rmm.log 2>&1
                chown -R eco:eco /home/eco >> /var/log/vdtg-rmm.log 2>&1

                # Check if sudo is installed, if not install it
                if ! dpkg -l | grep -q sudo; then
                    apt install -y sudo >> /var/log/vdtg-rmm.log 2>&1
                fi
                
                # Download and extract SteamCMD as the eco user to ensure correct permissions, then run it once to create necessary folders
                sudo -u eco bash -c "cd /home/eco/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
                sudo -u eco bash -c "cd /home/eco/steamcmd && tar -xvzf steamcmd_linux.tar.gz" >> /var/log/vdtg-rmm.log 2>&1
                sudo -u eco /home/eco/steamcmd/steamcmd.sh +quit >> /var/log/vdtg-rmm.log 2>&1

                # Use SteamCMD to download the ECO Dedicated Server files, install them in the correct folder with the correct user permissions
                sudo -u eco /home/eco/steamcmd/steamcmd.sh +force_install_dir /home/eco/eco_server +login anonymous +app_update 739590 -beta default validate +quit >> /var/log/vdtg-rmm.log 2>&1

            fi

            # Create systemd service for ECO Dedicated Server, but only if it doesn't already exist. The service file is selected based on the detected OS and version to ensure compatibility.
            SERVICE_SRC="/opt/vdtg-rmm/systemctl/${OS_ID}/${OS_VER}/eco-dedicated-server.service"
            SERVICE_DST="/etc/systemd/system/eco-dedicated-server.service"
            if [ -f "$SERVICE_SRC" ]; then
                cp "$SERVICE_SRC" "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                chown root:root "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                chmod 644 "$SERVICE_DST" >> /var/log/vdtg-rmm.log 2>&1
                systemctl daemon-reload >> /var/log/vdtg-rmm.log 2>&1
                systemctl enable eco-dedicated-server >> /var/log/vdtg-rmm.log 2>&1
                echo "ECO Dedicated Server service installed, please edit /home/eco/eco_server/Configs/* to configure the server and then start the service with: systemctl start eco-dedicated-server" >> /var/log/vdtg-rmm.log 2>&1

                # Inject userToken direct in ExecStart als deze in de config staat
                eco_userToken=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i '^eco_dedicated_server_userToken=' | awk -F'=' '{print $2}')
                if [ -n "$eco_userToken" ]; then
                    # Escape special characters for sed
                    escaped_token=$(printf '%s\n' "$eco_userToken" | sed -e 's/[\/&]/\\&/g')
                    sed -i "s|^ExecStart=/home/eco/eco_server/EcoServer.*|ExecStart=/home/eco/eco_server/EcoServer -userToken=$escaped_token|" "$SERVICE_DST"
                fi
            fi

            # Install required libgdiplus for ECO Dedicated Server
            if ! dpkg -l | grep -q libgdiplus; then
                apt install -y libgdiplus >> /var/log/vdtg-rmm.log 2>&1
            fi

        fi
    fi

    install_displaylink_driver=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_displaylink_driver' | awk -F'=' '{print $2}')
    if [ "$install_displaylink_driver" == "true" ]; then
        if [ ! -d "/opt/vdtg-rmm/displaylink-debian" ]; then
            
            # Install dependencies
            apt install -y unzip dkms lsb-release linux-headers-$(uname -r) linux-source libdrm-dev >> /var/log/vdtg-rmm.log 2>&1

            # Clone the displaylink-debian repository
            git clone https://github.com/AdnanHodzic/displaylink-debian.git /opt/vdtg-rmm/displaylink-debian >> /var/log/vdtg-rmm.log 2>&1

            # Make the install script non-interactive by automatically accepting installation of missing dependencies, but if a dependency is missing, display message and abort installation instead of trying to install it. This is to prevent issues with apt-get install hanging or asking for user input during the installation process.
            sed -i '/read -p "\$dep not found! Install\? \[Y\/n\] " response/,/if ! apt-get install \$dep/{/read -p/d;/response=/d;/if ! apt-get install \$dep/c\\t\t\techo "$dep not found! Aborting."\\n\t\t\texit 1}' /opt/vdtg-rmm/displaylink-debian/displaylink-debian.sh >> /var/log/vdtg-rmm.log 2>&1

            # Make the install script non-interactive by automatically accepting the license agreement
            sed -i '/echo -en "\\nPlease read the Software License Agreement/,/read ACCEPT/ { /echo -en/d; /read ACCEPT/c\\tACCEPT="y" }' /opt/vdtg-rmm/displaylink-debian/displaylink-debian.sh >> /var/log/vdtg-rmm.log 2>&1

            # Make the install script non-interactive by skipping the reboot prompt
            sed -i '/^setup_complete()/,/^}/c\\\nsetup_complete() {\n  echo "Reboot required to apply changes. Please reboot manually."\n}\n' /opt/vdtg-rmm/displaylink-debian/displaylink-debian.sh >> /var/log/vdtg-rmm.log 2>&1

            # Make the install script executable
            chmod +x /opt/vdtg-rmm/displaylink-debian/displaylink-debian >> /var/log/vdtg-rmm.log 2>&1

            # Run the install script
            sudo /opt/vdtg-rmm/displaylink-debian/displaylink-debian.sh --install >> /var/log/vdtg-rmm.log 2>&1

            touch /opt/vdtg-rmm/reboot-required

            # Set intel_modesetting to true in vdtg-rmm.config to ensure optimal performance and compatibility with DisplayLink drivers, but only if it is not already set to true.
            intel_modesetting=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'intel_modesetting' | awk -F'=' '{print $2}')
            if [ "$intel_modesetting" != "true" ]; then
                sed -i 's/^\([[:space:]]*intel_modesetting[[:space:]]*=[[:space:]]*\).*/\1true/' /opt/vdtg-rmm/vdtg-rmm.config >> /var/log/vdtg-rmm.log 2>&1
            fi

        fi
    fi

    intel_modesetting=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'intel_modesetting' | awk -F'=' '{print $2}')
    if [ "$intel_modesetting" == "true" ]; then
        
        # If the 20-displaylink.conf file doesn't exist or doesn't contain the correct Driver "modesetting" line, create/overwrite the file with the correct configuration to ensure optimal performance and compatibility with DisplayLink drivers.
        if [ ! -f "/etc/X11/xorg.conf.d/20-displaylink.conf" ] || ! grep -q 'Driver "modesetting"' /etc/X11/xorg.conf.d/20-displaylink.conf; then
            mkdir -p /etc/X11/xorg.conf.d >> /var/log/vdtg-rmm.log 2>&1
            echo 'Section "Device"' > /etc/X11/xorg.conf.d/20-displaylink.conf
            echo '    Identifier "Intel Graphics"' >> /etc/X11/xorg.conf.d/20-displaylink.conf
            echo '    Driver "modesetting"' >> /etc/X11/xorg.conf.d/20-displaylink.conf
            echo 'EndSection' >> /etc/X11/xorg.conf.d/20-displaylink.conf
        fi

        # If the xserver-xorg-video-intel package is installed, remove it to prevent conflicts with the modesetting driver and ensure optimal performance and compatibility with DisplayLink drivers.
        if dpkg -l | grep -q xserver-xorg-video-intel; then
            apt remove xserver-xorg-video-intel -y >> /var/log/vdtg-rmm.log 2>&1
        fi

        touch /opt/vdtg-rmm/reboot-required

    fi

    install_zoho_assist_remote_support=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_zoho_assist_remote_support' | awk -F'=' '{print $2}')
    if [ "$install_zoho_assist_remote_support" == "true" ]; then
        if [ ! -f "/usr/share/applications/zoho-assist.desktop" ]; then

            # Create applications folder if it doesn't exist
            if [ ! -d "/opt/vdtg-rmm/applications" ]; then
                mkdir -p /opt/vdtg-rmm/applications
            fi

            # Install dependencies for Zoho Assist Remote Support
            apt install -y wget fuse >> /var/log/vdtg-rmm.log 2>&1

            # Download and install Zoho Assist Remote Support
            wget -O /opt/vdtg-rmm/applications/ZohoAssist.AppImage https://downloads.zohocdn.com/assist-desktop/zoho-assist-desktop-x64.AppImage >> /var/log/vdtg-rmm.log 2>&1

            # Make the AppImage executable
            chmod +x /opt/vdtg-rmm/applications/ZohoAssist.AppImage >> /var/log/vdtg-rmm.log 2>&1

            # Create desktop entry for Zoho Assist Remote Support
            cp /opt/vdtg-rmm/applications/zoho-assist.desktop /usr/share/applications/zoho-assist.desktop >> /var/log/vdtg-rmm.log 2>&1
            chown root:root /usr/share/applications/zoho-assist.desktop >> /var/log/vdtg-rmm.log 2>&1
            chmod 644 /usr/share/applications/zoho-assist.desktop >> /var/log/vdtg-rmm.log 2>&1
            
            # Update the desktop database to recognize the new application
            update-desktop-database >> /var/log/vdtg-rmm.log 2>&1

        fi
    fi

    install_vscode=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_vscode' | awk -F'=' '{print $2}')
    if [ "$install_vscode" == "true" ]; then
        if ! dpkg -l | grep -q code; then
            # Install dependencies for Visual Studio Code
            apt install -y wget gpg >> /var/log/vdtg-rmm.log 2>&1

            # Download and install Microsoft GPG key and repository for Visual Studio Code
            wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft.gpg 2>> /var/log/vdtg-rmm.log
            echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://mirror.vdtg.nl/repos/vscode stable main" > /etc/apt/sources.list.d/vscode.list

            # Update repositories and install Visual Studio Code
            apt update >> /var/log/vdtg-rmm.log 2>&1
            apt install -y code >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_remmina=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_remmina' | awk -F'=' '{print $2}')
    if [ "$install_remmina" == "true" ]; then
        if ! dpkg -l | grep -q remmina; then
            apt install -y remmina remmina-plugin-rdp >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    if [ "$OS_ID" = "linuxmint" ]; then

        install_lmde_multimedia_support=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_lmde_multimedia_support' | awk -F'=' '{print $2}')
        if [ "$install_lmde_multimedia_support" == "true" ]; then
            if ! dpkg -l | grep -q mint-meta-codecs; then
                apt install -y mint-meta-codecs >> /var/log/vdtg-rmm.log 2>&1
            fi
        fi

        ufw_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'ufw_enable' | awk -F'=' '{print $2}')
        if [ "$ufw_enable" == "true" ]; then
            
            if ! dpkg -l | grep -q ufw; then
                apt install -y ufw >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Check if firewall is already enabled, if not enable it
            if ! ufw status | grep -q "Status: active"; then
                ufw enable >> /var/log/vdtg-rmm.log 2>&1
            fi

        elif [ "$ufw_enable" == "false" ]; then
            if dpkg -l | grep -q ufw; then
                # Check if firewall is already disabled, if not disable it
                if ufw status | grep -q "Status: active"; then
                    ufw disable >> /var/log/vdtg-rmm.log 2>&1
                fi
            fi
        fi

        install_lmde_language_packs=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_lmde_language_packs' | awk -F'=' '{print $2}')
        if [ "$install_lmde_language_packs" == "true" ]; then

            locale=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'locale' | awk -F'=' '{print $2}')
            if [ "$locale" == "nl" ]; then

                if ! dpkg -l | grep -q libreoffice-help-nl; then
                    apt install -y libreoffice-help-nl
                fi
                if ! dpkg -l | grep -q hyphen-nl; then
                    apt install -y hyphen-nl
                fi
                if ! dpkg -l | grep -q hunspell-nl; then
                    apt install -y hunspell-nl
                fi
                if ! dpkg -l | grep -q wdutch; then
                    apt install -y wdutch
                fi

            fi
            
        fi

    fi

    install_spotify_client=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_spotify_client' | awk -F'=' '{print $2}')
    if [ "$install_spotify_client" == "true" ]; then
        if ! dpkg -l | grep -q spotify-client; then
            
            # Check if dependencies for Spotify client are installed, else install.
            if ! dpkg -l | grep -q apt-transport-https; then
                apt install -y apt-transport-https >> /var/log/vdtg-rmm.log 2>&1
            fi
            if ! dpkg -l | grep -q ca-certificates; then
                apt install -y ca-certificates >> /var/log/vdtg-rmm.log 2>&1
            fi
            if ! dpkg -l | grep -q wget; then
                apt install -y wget >> /var/log/vdtg-rmm.log 2>&1
            fi
            if ! dpkg -l | grep -q gpg; then
                apt install -y gpg >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Download and install Spotify GPG key and repository
            wget -qO- https://download.spotify.com/debian/pubkey_5384CE82BA52C83A.asc | gpg --dearmor > /usr/share/keyrings/spotify.gpg 2>> /var/log/vdtg-rmm.log
            echo "deb [arch=amd64 signed-by=/usr/share/keyrings/spotify.gpg] https://mirror.vdtg.nl/spotify stable non-free" > /etc/apt/sources.list.d/spotify.list

            # Update repositories and install Spotify client
            apt update >> /var/log/vdtg-rmm.log 2>&1
            apt install -y spotify-client >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_filezilla_client=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_filezilla_client' | awk -F'=' '{print $2}')
    if [ "$install_filezilla_client" == "true" ]; then
        if ! dpkg -l | grep -q filezilla; then
            apt install -y filezilla >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_ckb_next=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_ckb_next' | awk -F'=' '{print $2}')
    if [ "$install_ckb_next" == "true" ]; then
        if ! dpkg -l | grep -q ckb-next; then
            # Install dependencies for ckb-next
            apt install -y build-essential cmake qt6-base-dev libudev-dev zlib1g-dev libpulse-dev libquazip1-qt6-dev qt6-tools-dev qt6-wayland-dev libxcb-screensaver0-dev libxcb-ewmh-dev libxcb1-dev wayland-protocols >> /var/log/vdtg-rmm.log 2>&1

            # Clone ckb-next repository and run quickinstall script
            git clone https://github.com/ckb-next/ckb-next.git /opt/vdtg-rmm/ckb-next >> /var/log/vdtg-rmm.log 2>&1 && cd /opt/vdtg-rmm/ckb-next && ./quickinstall >> /var/log/vdtg-rmm.log 2>&1

        fi
    fi

    install_cuda_drivers=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_cuda_drivers' | awk -F'=' '{print $2}')
    if [ "$install_cuda_drivers" == "true" ]; then
        if ! dpkg -l | grep -q cuda-drivers; then
            # Check if the CUDA keyring deb file is already downloaded, if not download it
            if [ ! -f "/opt/vdtg-rmm/cuda-keyring.deb" ]; then
                wget https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb -O /opt/vdtg-rmm/cuda-keyring.deb >> /var/log/vdtg-rmm.log 2>&1
            fi

            # Install the CUDA keyring deb file, update package lists, and install cuda-drivers
            dpkg -i /opt/vdtg-rmm/cuda-keyring.deb >> /var/log/vdtg-rmm.log 2>&1
            apt update >> /var/log/vdtg-rmm.log 2>&1
            apt install -y cuda-drivers >> /var/log/vdtg-rmm.log 2>&1

            # Create reboot-required file to ensure drivers are properly loaded after installation
            touch /opt/vdtg-rmm/reboot-required
        fi
    fi

    install_traceroute=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_traceroute' | awk -F'=' '{print $2}')
    if [ "$install_traceroute" == "true" ]; then
        if ! dpkg -l | grep -q traceroute; then
            apt install -y traceroute >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    install_ethtool=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_ethtool' | awk -F'=' '{print $2}')
    if [ "$install_ethtool" == "true" ]; then
        if ! dpkg -l | grep -q ethtool; then
            apt install -y ethtool >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

    # Check if reboot is required and if so, check config for reboot_auto setting. If reboot_auto is true, remove reboot-required file and reboot system, otherwise display message that a reboot is required.
    if [ -f "/opt/vdtg-rmm/reboot-required" ]; then
        reboot_auto=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'reboot_auto' | awk -F'=' '{print $2}')
        if [ "$reboot_auto" == "true" ]; then
            rm /opt/vdtg-rmm/reboot-required
            reboot
        else
            rm /opt/vdtg-rmm/reboot-required
            echo "A reboot is required to complete the installation of updates and/or locale changes. Please reboot the system as soon as possible to ensure optimal performance and stability." >> /var/log/vdtg-rmm.log 2>&1
        fi
    fi

else
    echo "Application not installed at /opt/vdtg-rmm. Please install application in the correct folder." >> /var/log/vdtg-rmm.log 2>&1
    exit 1
fi