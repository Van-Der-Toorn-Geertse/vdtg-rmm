#!/bin/bash

# Check if application is run as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run application as root"
  exit
fi

# Check if /opt/vdtg-rmm application folder exists else stop code execution
if [ -d "/opt/vdtg-rmm" ]; then

    cd /opt/vdtg-rmm

    # Ensure daemon is executable
    if [ ! -x /opt/vdtg-rmm/vdtg-rmm-daemon ]; then
        chmod +x /opt/vdtg-rmm/vdtg-rmm-daemon
    fi

    # Check if config file exists, if not copy example config file. If config file exists check for empty values and fill them with default values from example config file, also check for missing lines (including comments) and add them to config file
    if [ ! -f /opt/vdtg-rmm/vdtg-rmm.config ]; then
        cp /opt/vdtg-rmm/vdtg-rmm.config.example /opt/vdtg-rmm/vdtg-rmm.config
    else
        # Check for empty values and fill them with default values from example config file
        while IFS= read -r line; do
            if [[ ! $line == \#* ]] && [ ! -z "$line" ]; then
                key=$(echo $line | awk -F'=' '{print $1}')
                value=$(echo $line | awk -F'=' '{print $2}')
                if [ -z "$value" ]; then
                    default_value=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config.example | grep -i "^$key=" | awk -F'=' '{print $2}')
                    sed -i "s/^$key=/$key=$default_value/" /opt/vdtg-rmm/vdtg-rmm.config
                fi
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config

        # Check for missing lines (including comments) and add them to config file
        while IFS= read -r line; do
            if ! grep -Fxq "$line" /opt/vdtg-rmm/vdtg-rmm.config; then
                echo "$line" >> /opt/vdtg-rmm/vdtg-rmm.config
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config.example
    fi

    # Check config for cron_enable setting, if true enable cron and add vdtg-rmm-daemon to crontab if not already present (every 6 hours), if false remove vdtg-rmm-daemon from crontab if present
    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        # Ensure cron is installed and enabled
        if ! dpkg -l | grep -q cron; then
            apt install -y cron
        fi
        systemctl enable --now cron

        # Add vdtg-rmm-daemon to crontab if not already present (every 6 hours)
        if ! crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            (crontab -l 2>/dev/null; echo "0 */6 * * * /opt/vdtg-rmm/vdtg-rmm-daemon") | crontab -
        fi
    else
        # Remove vdtg-rmm-daemon from crontab if present
        if crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            crontab -l 2>/dev/null | grep -v "/opt/vdtg-rmm/vdtg-rmm-daemon" | crontab -
        fi
    fi

    # Detect OS and version
    OS_ID="$(. /etc/os-release && echo "$ID")"
    OS_VER="$(. /etc/os-release && echo "$VERSION_ID")"

    # Set sources paths based on detected OS and version, currently only supports Ubuntu but can be expanded in the future for other Debian-based distributions
    if [ "$OS_ID" = "ubuntu" ]; then
        # Set sources paths for Ubuntu
        SRC_LIST_FILE="/opt/vdtg-rmm/sources/ubuntu/${OS_VER}/sources.list"
        SRC_UBUNTU_SOURCES_FILE="/opt/vdtg-rmm/sources/ubuntu/${OS_VER}/ubuntu.sources"
    else
        SRC_LIST_FILE=""
        SRC_UBUNTU_SOURCES_FILE=""
    fi

    # Copy ubuntu.sources if it exists and is different
    if [ -n "$SRC_UBUNTU_SOURCES_FILE" ] && [ -f "$SRC_UBUNTU_SOURCES_FILE" ]; then
        DST_UBUNTU_SOURCES_FILE="/etc/apt/sources.list.d/ubuntu.sources"
        # Ensure destination directory exists
        mkdir -p /etc/apt/sources.list.d
        if [ ! -f "$DST_UBUNTU_SOURCES_FILE" ] || ! cmp -s "$SRC_UBUNTU_SOURCES_FILE" "$DST_UBUNTU_SOURCES_FILE"; then
            cp "$SRC_UBUNTU_SOURCES_FILE" "$DST_UBUNTU_SOURCES_FILE"
        fi

        # Remove sources.list if it exists to prevent conflicts with ubuntu.sources
        if [ -f "/etc/apt/sources.list" ]; then
            rm "/etc/apt/sources.list"
        fi
    else
        # Copy sources.list if it exists and is different
        if [ -n "$SRC_LIST_FILE" ] && [ -f "$SRC_LIST_FILE" ]; then
            DST_LIST_FILE="/etc/apt/sources.list"
            if [ ! -f "$DST_LIST_FILE" ] || ! cmp -s "$SRC_LIST_FILE" "$DST_LIST_FILE"; then
                cp "$SRC_LIST_FILE" "$DST_LIST_FILE"
            fi
        fi
    fi

    # Check config for cron_enable setting, if true disable cron before updates to prevent conflicts with package manager and re-enable it after updates
    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1false/' /opt/vdtg-rmm/vdtg-rmm.config
    fi

    # Check config for update_os setting, if true then refresh repositories and update system
    update_os=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'update_os' | awk -F'=' '{print $2}')
    if [ "$update_os" == "true" ]; then

        # Set non-interactive frontend for apt to avoid prompts during updates
        export DEBIAN_FRONTEND=noninteractive

        # Refresh repositories and update system
        apt clean
        apt update
        apt-get -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" -y upgrade

    fi

    # Check config for install_git setting, if true then check if git is installed and install it if not
    install_git=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_git' | awk -F'=' '{print $2}')
    if [ "$install_git" == "true" ]; then
        if ! dpkg -l | grep -q git; then
            apt install -y git
        fi
    fi

    # Check config for install_net_tools setting, if true then check if net-tools is installed and install it if not
    install_net_tools=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_net_tools' | awk -F'=' '{print $2}')
    if [ "$install_net_tools" == "true" ]; then
        if ! dpkg -l | grep -q net-tools; then
            apt install -y net-tools
        fi
    fi

    # Check config for install_iputils_ping setting, if true then check if iputils-ping is installed and install it if not
    install_iputils_ping=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_iputils_ping' | awk -F'=' '{print $2}')
    if [ "$install_iputils_ping" == "true" ]; then
        if ! dpkg -l | grep -q iputils-ping; then
            apt install -y iputils-ping
        fi
    fi

    # Check config for locale setting, if set to nl then install locales package if not installed and set system locale to nl_NL.UTF-8
    locale=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'locale' | awk -F'=' '{print $2}')
    if [ -n "$locale" ]; then
        if ! dpkg -l | grep -q "locales"; then
            apt install -y locales
        fi
        if [ "$locale" == "nl" ]; then
            if [ "$(locale | grep LANG= | awk -F'=' '{print $2}')" != "nl_NL.UTF-8" ]; then
                locale-gen nl_NL.UTF-8
                update-locale LANG=nl_NL.UTF-8
            fi
        fi
    fi

    # Check config for install_docker setting, if true then check if docker is installed and install it if not
    install_docker=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_docker' | awk -F'=' '{print $2}')
    if [ "$install_docker" == "true" ]; then
        # Check if docker-data folder exists in /opt/vdtg-rmm, if not create it and set permissions to 755
        if [ ! -d "/opt/vdtg-rmm/docker-data" ]; then
            mkdir /opt/vdtg-rmm/docker-data
            chmod 755 /opt/vdtg-rmm/docker-data
        fi
        # Check if docker-ce package is installed, if not install docker-ce, docker-ce-cli and containerd.io packages
        if ! dpkg -l | grep -q docker-ce; then
            # Copy ubuntu.list if it exists and is different
            if [ -f "/opt/vdtg-rmm/sources/ubuntu/${OS_VER}/docker.list" ]; then
                if [ ! -f "/etc/apt/sources.list.d/docker.list" ] || ! cmp -s "/opt/vdtg-rmm/sources/ubuntu/${OS_VER}/docker.list" "/etc/apt/sources.list.d/docker.list"; then
                    cp "/opt/vdtg-rmm/sources/ubuntu/${OS_VER}/docker.list" "/etc/apt/sources.list.d/docker.list"
                fi
            fi

            # Add Docker GPG key if not already added
            if ! apt-key list | grep -q "Docker"; then
                curl -fsSL https://download.docker.com/linux/ubuntu/gpg | apt-key add -
            fi

            # Refresh repositories and install docker-ce, docker-ce-cli and containerd.io packages
            apt clean
            apt update
            apt install -y docker-ce docker-ce-cli containerd.io
        fi

        # Check if docker is running, if not start docker service
        if ! systemctl is-active --quiet docker; then
            systemctl start docker
        fi

        # Check again if docker is running
        if systemctl is-active --quiet docker; then
            # Check config for install_portainer setting, if true then check if portainer container is running and install it if not
            install_portainer=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_portainer' | awk -F'=' '{print $2}')
            if [ "$install_portainer" == "true" ]; then
                # Check if docker-compose file for portainer exists, if it does check if portainer container is running and install it if not, if it is running pull latest image and recreate container
                if [ -f "/opt/vdtg-rmm/docker-compose/portainer/docker-compose.yml" ]; then
                    # Check if portainer container is running, if not start portainer container using docker-compose, if it is running pull latest image and recreate container
                    if ! docker ps --format '{{.Names}}' | grep -q "vdtg-rmm-portainer"; then
                        # Start portainer container using docker-compose
                        docker-compose -f /opt/vdtg-rmm/docker-compose/portainer/docker-compose.yml up -d
                    else
                        # Pull latest image and recreate container
                        docker-compose -f /opt/vdtg-rmm/docker-compose/portainer/docker-compose.yml pull
                        docker-compose -f /opt/vdtg-rmm/docker-compose/portainer/docker-compose.yml up -d
                    fi
                fi
            fi
            # Check config for install_lancache setting, if true then check if lancache container is running and install it if not
            install_lancache=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_lancache' | awk -F'=' '{print $2}')
            if [ "$install_lancache" == "true" ]; then
                # Check if docker-compose file for lancache exists, if it does check if lancache container is running and install it if not, if it is running pull latest image and recreate container
                if [ -f "/opt/vdtg-rmm/docker-compose/lancache/docker-compose.yml" ]; then
                    # Check if lancache container is running, if not start lancache container using docker-compose, if it is running pull latest image and recreate container
                    if ! docker ps --format '{{.Names}}' | grep -q "vdtg-rmm-lancache"; then
                        # Check if .env file exists in lancache docker-compose folder, if not copy .env.example to .env
                        if [ ! -f "/opt/vdtg-rmm/docker-compose/lancache/.env" ]; then
                            # Copy .env.example to .env
                            cp /opt/vdtg-rmm/docker-compose/lancache/.env.example /opt/vdtg-rmm/docker-compose/lancache/.env
                            
                            # Prompt user to edit .env file with appropriate values before running the application
                            echo "Please edit the .env file with appropriate values before running the application"

                            # Set install_lancache to false in config file to prevent errors on next run
                            sed -i 's/^\([[:space:]]*install_lancache[[:space:]]*=[[:space:]]*\).*/\1false/' /opt/vdtg-rmm/vdtg-rmm.config

                            # Re-enable cron if it was enabled before updates
                            if [ "$cron_enable" == "true" ]; then
                                sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1true/' /opt/vdtg-rmm/vdtg-rmm.config
                            fi

                            # Exit the script to allow user to edit .env file
                            exit
                        fi
                        # Start lancache container using docker-compose
                        docker-compose -f /opt/vdtg-rmm/docker-compose/lancache/docker-compose.yml up -d
                    else
                        # Check if update_lancache setting is true, if it is true pull latest image and recreate container, if it is false do nothing
                        update_lancache=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'update_lancache' | awk -F'=' '{print $2}')
                        if [ "$update_lancache" == "true" ]; then
                            # Pull latest image and recreate container
                            docker-compose -f /opt/vdtg-rmm/docker-compose/lancache/docker-compose.yml pull
                            docker-compose -f /opt/vdtg-rmm/docker-compose/lancache/docker-compose.yml up -d
                        fi
                    fi
                fi
            fi
        fi    
    fi

    # Re-enable cron if it was enabled before updates
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1true/' /opt/vdtg-rmm/vdtg-rmm.config
    fi

    # Check config for update_reboot setting, if true and /var/run/reboot-required file exists then reboot system
    update_reboot=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'update_reboot' | awk -F'=' '{print $2}')
    if [ "$update_reboot" == "true" ] && [ -f /var/run/reboot-required ]; then
        echo "Reboot required. Rebooting now..."
        reboot
    else
        echo "No reboot required. Exiting application."
        exit
    fi

else
    echo "Application not installed at /opt/vdtg-rmm. Please install application in the correct folder."
    exit
fi