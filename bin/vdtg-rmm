#!/bin/bash

# Check if application is run as root
if [ "$EUID" -ne 0 ]
  then echo "Please run application as root or with sudo"
  exit
fi

# Check if /opt/vdtg-rmm application folder exists else stop code execution
if [ -d "/opt/vdtg-rmm" ]
then

    # Move to vdtg-rmm application folder
    cd /opt/vdtg-rmm

    # Check if daemon file is executable
    if [ ! -x /opt/vdtg-rmm/vdtg-rmm-daemon ]
    then
        # Make vdtg-rmm daemon executable
        chmod +x /opt/vdtg-rmm/vdtg-rmm-daemon
    fi

    # Ensure cron (cronie) is installed
    if ! rpm -q cronie >/dev/null 2>&1; then
        echo "Installing cron (cronie)..."
        zypper install -y cronie
    fi

    # Ensure cron service is enabled and running
    if systemctl list-unit-files | grep -q crond.service; then
        systemctl enable --now crond
    else
        systemctl enable --now cron
    fi

    # Add vdtg-rmm-daemon to crontab if not already present
    if ! crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
        echo "Adding cronjob for vdtg-rmm-daemon (every 6 hours)..."
        (crontab -l 2>/dev/null; echo "0 */6 * * * /opt/vdtg-rmm/vdtg-rmm-daemon") | crontab -
    fi

    # Check if config file exists, if not copy example config file, else check if all config values are set or copy missing values from example config file
    if [ ! -f /opt/vdtg-rmm/vdtg-rmm.config ]
    then
        # Copy example config file to /opt/vdtg-rmm
        cp /opt/vdtg-rmm/vdtg-rmm.config.example /opt/vdtg-rmm/vdtg-rmm.config
    else
        # Check if all config values are set, if not copy missing values from example config file
        while IFS= read -r line
        do
            # Check if line is not a comment
            if [[ ! $line == \#* ]]
            then
                # Check if line is not empty
                if [ ! -z "$line" ]
                then
                    # Get key from line
                    key=$(echo $line | awk -F'=' '{print $1}')

                    # Get value from line
                    value=$(echo $line | awk -F'=' '{print $2}')

                    # Check if value is empty
                    if [ -z "$value" ]
                    then
                        # Get value from example config file
                        default_value=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config.example | grep -i $key | awk -F'=' '{print $2}')

                        # Add key and value to config file
                        sed -i "s/$key=/$key=$default_value/g" /opt/vdtg-rmm/vdtg-rmm.config
                    fi
                fi
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config
    fi

    # Replace openSUSE repo definitions with VDTG repos (no backups)
    SRC_REPO_DIR="/opt/vdtg-rmm/repos/leap"
    DST_REPO_DIR="/etc/zypp/repos.d"

    # Fail early if source repo dir is missing or empty
    if [ ! -d "$SRC_REPO_DIR" ] || ! ls -1 "$SRC_REPO_DIR"/*.repo >/dev/null 2>&1; then
        echo "ERROR: No .repo files found in $SRC_REPO_DIR. Aborting repo replacement."
    else
        echo "Cleaning existing openSUSE/vdtg repo files in $DST_REPO_DIR ..."

        # Remove default openSUSE repos and any previous vdtg-* repos (no backups)
        shopt -s nullglob
        for f in "$DST_REPO_DIR"/*.repo; do
            bn="$(basename "$f")"
            if [[ "$bn" == vdtg-* ]] || \
               [[ "$bn" == openSUSE* ]] || \
               [[ "$bn" == *oss*.repo ]] || \
               [[ "$bn" == *non-oss*.repo ]] || \
               [[ "$bn" == *update*.repo ]] || \
               [[ "$bn" == *backports*.repo ]] || \
               [[ "$bn" == *debug*.repo ]] || \
               [[ "$bn" == *sle*.repo ]] || \
               [[ "$bn" == *source*.repo ]] || \
               [[ "$bn" == *openh264*.repo ]]; then
                rm -f "$f"
            fi
        done
        shopt -u nullglob

        echo "Installing VDTG .repo set from $SRC_REPO_DIR ..."
        cp -f "$SRC_REPO_DIR"/*.repo "$DST_REPO_DIR"/

    fi

    # Refresh repositories
    echo "Refreshing repositories..."
    zypper refresh

    # Install package updates
    echo "Checking for and if available installing package updates..."
    zypper update -y

    # Check if git is installed
    if ! rpm -q git >/dev/null 2>&1; then
        echo "Installing git..."
        zypper install -y git
    fi

    # Check if net-tools is installed
    if ! rpm -q net-tools >/dev/null 2>&1; then
        echo "Installing net-tools..."
        zypper install -y net-tools
    fi

    # Check if iputils (contains ping) is installed
    if ! rpm -q iputils >/dev/null 2>&1; then
        echo "Installing iputils..."
        zypper install -y iputils
    fi

    # Get locale from vdtg-rmm.config file (ignore commented lines)
    locale=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'locale' | awk -F'=' '{print $2}')

    # Ensure glibc-locale is installed (required for all locales)
    if ! rpm -q glibc-locale >/dev/null 2>&1 && ! rpm -q glibc-locale-base >/dev/null 2>&1; then
        zypper install -y glibc-locale glibc-locale-base
    fi

    # If locale is nl then set locale to Dutch
    if [ "$locale" == "nl" ]; then
        echo "Setting system locale to Dutch..."
        localectl set-locale LANG=nl_NL.UTF-8
        localectl set-keymap us-intl
    fi

    # Get install_dnsmasq from vdtg-rmm.config file (ignore commented lines)
    install_dnsmasq=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_dnsmasq' | awk -F'=' '{print $2}')

    # Check if install_dnsmasq is true
    if [ "$install_dnsmasq" == "true" ]; then

        # Check if dnsmasq is installed
        if ! rpm -q dnsmasq >/dev/null 2>&1; then
            echo "dnsmasq not installed, installing..."

            # Disable systemd-resolved only if it exists (some openSUSE systems do not use it)
            if systemctl list-unit-files | grep -q systemd-resolved.service; then
                systemctl stop systemd-resolved
                systemctl disable systemd-resolved
            fi

            # Install dnsmasq
            zypper install -y dnsmasq
        fi
    fi

    #############################
    # Docker-installatie (alleen als NIET in container)
    #############################

    # Lees setting uit config
    install_docker=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_docker' | awk -F'=' '{print $2}')

    if [ "$install_docker" = "true" ]; then

        # Bepaal of we in een container draaien (LXC, Docker, Podman, systemd-nspawn, etc.)
        in_container="false"
        container_type="unknown"
    
        # 1) systemd-detect-virt (betrouwbaar voor LXC/containers)
        if command -v systemd-detect-virt >/dev/null 2>&1; then
            ct_out="$(systemd-detect-virt --container 2>/dev/null || true)"
            if [ -n "$ct_out" ] && [ "$ct_out" != "none" ]; then
                in_container="true"
                container_type="$ct_out"
            fi
        fi
    
        # 2) Fallback-signalen (als systemd-detect-virt ontbreekt of niets meldt)
        #   - /.dockerenv : Docker container
        #   - /run/systemd/container : systemd-nspawn of andere container hints
        #   - lxc-namespace in /proc/1/environ
        if [ "$in_container" = "false" ]; then
            if [ -f "/.dockerenv" ]; then
                in_container="true"
                container_type="docker"
            elif [ -f "/run/systemd/container" ]; then
                in_container="true"
                container_type="$(cat /run/systemd/container 2>/dev/null || echo systemd-container)"
            elif tr '\0' '\n' < /proc/1/environ 2>/dev/null | grep -qi 'container='; then
                in_container="true"
                container_type="generic-container"
            fi
        fi
    
        # Log containerstatus
        if [ "$in_container" = "true" ]; then
            echo "Detected container environment: ${container_type}"
            echo "Docker installation and deployments will be skipped inside containers."
        else
            echo "No container environment detected; proceeding with Docker logic if enabled."
        fi
    
        if [ "$in_container" = "false" ]; then
    
            # Check of Docker al geïnstalleerd is
            if ! rpm -q docker >/dev/null 2>&1; then
                echo "Docker not installed, installing via openSUSE repositories..."
                zypper install -y docker docker-compose docker-buildx
    
                # Zorg voor docker group
                if ! getent group docker >/dev/null 2>&1; then
                    groupadd docker
                fi
    
                # Enable & start Docker
                systemctl enable --now docker
            fi
    
            # Post-install basis: datafolder
            if [ ! -d "/opt/vdtg-rmm/docker-data" ]; then
                mkdir /opt/vdtg-rmm/docker-data
            fi
    
            # Portainer (optioneel)
            install_portainer=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_portainer' | awk -F'=' '{print $2}')
            if [ "$install_portainer" = "true" ]; then
                if ! docker ps -a | grep -q vdtg-portainer; then
                    echo "Deploying Portainer via compose..."
                    docker compose -f /opt/vdtg-rmm/docker-compose/portainer/docker-compose.yml up -d
                else
                    echo "Portainer container already exists; skipping deploy."
                fi
            fi
    
        elif [ "$in_container" = "true" ]; then
            # We draaien in een container: Docker overslaan, maar wel even melden of het geconfigureerd stond
            if [ "$install_docker" = "true" ]; then
                echo "NOTE: 'install_docker=true' in config, but running inside a container (${container_type})."
                echo "      Skipping Docker install and compose deployments by design."
            fi
        fi
    fi

else
    echo "Application not installed at /opt/vdtg-rmm. Please install application in the correct folder."
    exit
fi
