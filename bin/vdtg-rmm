#!/bin/bash

# Check if application is run as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run application as root"
  exit
fi

# Check if /opt/vdtg-rmm application folder exists else stop code execution
if [ -d "/opt/vdtg-rmm" ]; then

    cd /opt/vdtg-rmm

    # Ensure daemon is executable
    if [ ! -x /opt/vdtg-rmm/vdtg-rmm-daemon ]; then
        chmod +x /opt/vdtg-rmm/vdtg-rmm-daemon
    fi

    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        # Ensure cron is installed and enabled
        if ! dpkg -l | grep -q cron; then
            apt install -y cron
        fi
        systemctl enable --now cron

        # Add vdtg-rmm-daemon to crontab if not already present (every 6 hours)
        if ! crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            (crontab -l 2>/dev/null; echo "0 */6 * * * /opt/vdtg-rmm/vdtg-rmm-daemon") | crontab -
        fi
    else
        # Remove vdtg-rmm-daemon from crontab if present
        if crontab -l 2>/dev/null | grep -q "/opt/vdtg-rmm/vdtg-rmm-daemon"; then
            crontab -l 2>/dev/null | grep -v "/opt/vdtg-rmm/vdtg-rmm-daemon" | crontab -
        fi
    fi

    # Config file logic
    if [ ! -f /opt/vdtg-rmm/vdtg-rmm.config ]; then
        cp /opt/vdtg-rmm/vdtg-rmm.config.example /opt/vdtg-rmm/vdtg-rmm.config
    else
        # Vul lege values aan
        while IFS= read -r line; do
            if [[ ! $line == \#* ]] && [ ! -z "$line" ]; then
                key=$(echo $line | awk -F'=' '{print $1}')
                value=$(echo $line | awk -F'=' '{print $2}')
                if [ -z "$value" ]; then
                    default_value=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config.example | grep -i "^$key=" | awk -F'=' '{print $2}')
                    sed -i "s/^$key=/$key=$default_value/" /opt/vdtg-rmm/vdtg-rmm.config
                fi
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config

        # Voeg ontbrekende regels (inclusief comments) toe
        while IFS= read -r line; do
            # Check of regel exact voorkomt in config
            if ! grep -Fxq "$line" /opt/vdtg-rmm/vdtg-rmm.config; then
                echo "$line" >> /opt/vdtg-rmm/vdtg-rmm.config
            fi
        done < /opt/vdtg-rmm/vdtg-rmm.config.example
    fi

    # Detect OS and version, then select correct sources.list file
    OS_ID="$(. /etc/os-release && echo "$ID")"
    OS_VER="$(. /etc/os-release && echo "$VERSION_ID")"

    # Detect Proxmox by checking for /etc/pve or /etc/proxmox-ve or installed package
    if [ -d "/etc/pve" ] || [ -f "/etc/proxmox-ve" ] || dpkg -l | grep -q "proxmox-ve"; then
        OS_ID="proxmox"
        # Try to get Proxmox version from /etc/pve/version (first digit)
        if [ -f "/etc/pve/version" ]; then
            PROXMOX_VER=$(head -n1 /etc/pve/version | grep -oE '^[0-9]+')
        fi
        # If not found, try dpkg-query proxmox-ve
        if [ -z "$PROXMOX_VER" ]; then
            PROXMOX_VER=$(dpkg-query -W -f='${Version}' proxmox-ve 2>/dev/null | grep -oE '^[0-9]+')
        fi
        # Fallback to 8 if still not found
        if [ -z "$PROXMOX_VER" ]; then
            PROXMOX_VER="8"
        fi
        # Set OS_VER to Proxmox version 
        OS_VER="$PROXMOX_VER"
        # Set sources.list paths for Proxmox
        SRC_FILE="/opt/vdtg-rmm/sources/proxmox/${PROXMOX_VER}/sources.list"
        DST_FILE="/etc/apt/sources.list"
    elif [ "$OS_ID" = "debian" ]; then
        # Check if /etc/apt/sources.list or /etc/apt/sources.list.d/debian.sources is used.
        if [ -f "/etc/apt/sources.list.d/debian.sources" ]; then
            SRC_FILE="/opt/vdtg-rmm/sources/debian/${OS_VER}/debian.sources"
            DST_FILE="/etc/apt/sources.list.d/debian.sources"
        else
            SRC_FILE="/opt/vdtg-rmm/sources/debian/${OS_VER}/sources.list"
            DST_FILE="/etc/apt/sources.list"
        fi
    elif [ "$OS_ID" = "linuxmint" ]; then
        # Set sources.list paths for LMDE (Linux Mint Debian Edition)
        SRC_FILE="/opt/vdtg-rmm/sources/lmde/${OS_VER}/official-package-repositories.list"
        DST_FILE="/etc/apt/sources.list.d/official-package-repositories.list"
    else
        # Unsupported OS, skip sources.list setup
        SRC_FILE=""
        DST_FILE=""
        echo "Unsupported OS: $OS_ID. Skipping sources.list setup. Please contact support to add compatibility for your OS."
    fi

    # If source file exists and is different from destination, copy it
    if [ -n "$SRC_FILE" ] && [ -f "$SRC_FILE" ]; then
        # Only copy if destination file doesn't exist or is different from source
        if [ ! -f "$DST_FILE" ] || ! cmp -s "$SRC_FILE" "$DST_FILE"; then
            cp "$SRC_FILE" "$DST_FILE"
        fi
    fi

    # Check config for cron_enable and update_auto settings, if cron_enable is true disable cron before updates and re-enable after updates
    cron_enable=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'cron_enable' | awk -F'=' '{print $2}')
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1false/' /opt/vdtg-rmm/vdtg-rmm.config
    fi

    update_auto=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'update_auto' | awk -F'=' '{print $2}')
    if [ "$update_auto" == "true" ]; then
        # Refresh repositories and update system
        apt clean
        apt update

        # If OS is Proxmox, use apt dist-upgrade to ensure kernel and proxmox packages are also updated, otherwise use apt upgrade.
        if [ "$OS_ID" == "proxmox" ]; then
            apt dist-upgrade -y
        else
            apt upgrade -y
        fi
    fi

    # After updates, re-enable cron if it was enabled before
    if [ "$cron_enable" == "true" ]; then
        sed -i 's/^\([[:space:]]*cron_enable[[:space:]]*=[[:space:]]*\).*/\1true/' /opt/vdtg-rmm/vdtg-rmm.config
    fi

    # Locale setup, first check if OS is not Proxmox since Proxmox has its own locale settings and changing them can cause issues with the Proxmox web interface. If not Proxmox, check config for locale setting and install locales package if not already installed, then set system locale based on config value (nl or en).
    if [ "$OS_ID" != "proxmox" ]; then
        locale=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'locale' | awk -F'=' '{print $2}')
        if [ -n "$locale" ]; then
            if ! dpkg -l | grep -q "locales"; then
                apt install -y locales
            fi
            if [ "$locale" == "nl" ]; then
                # Uncomment nl_NL.UTF-8 UTF-8 in /etc/locale.gen if commented
                sed -i 's/^# *\(nl_NL\.UTF-8 UTF-8\)/\1/' /etc/locale.gen

                # Generate locale and update system locale settings
                locale-gen nl_NL.UTF-8
                update-locale LANG=nl_NL.UTF-8 LC_MESSAGES=POSIX
            elif [ "$locale" == "en" ]; then
                # Uncomment en_US.UTF-8 UTF-8 in /etc/locale.gen if commented
                sed -i 's/^# *\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen

                # Generate locale and update system locale settings
                locale-gen en_US.UTF-8
                update-locale LANG=en_US.UTF-8 LC_MESSAGES=POSIX
            fi
        fi
    fi

    install_git=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_git' | awk -F'=' '{print $2}')
    if [ "$install_git" == "true" ]; then
        if ! dpkg -l | grep -q git; then
            apt install -y git
        fi
    fi

    install_net_tools=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_net_tools' | awk -F'=' '{print $2}')
    if [ "$install_net_tools" == "true" ]; then
        if ! dpkg -l | grep -q net-tools; then
            apt install -y net-tools
        fi
    fi

    install_iputils_ping=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_iputils_ping' | awk -F'=' '{print $2}')
    if [ "$install_iputils_ping" == "true" ]; then
        if ! dpkg -l | grep -q iputils-ping; then
            apt install -y iputils-ping
        fi
    fi

    install_steamcmd=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_steamcmd' | awk -F'=' '{print $2}')
    if [ "$install_steamcmd" == "true" ]; then
        if ! dpkg -l | grep -q steamcmd; then
            # Install required 32-bit libraries for SteamCMD
            if ! dpkg -l | grep -q lib32gcc-s1; then
                apt install -y lib32gcc-s1
            fi

            # Create steamcmd user if not exists
            if ! id -u steamcmd >/dev/null 2>&1; then
                useradd -m -s /bin/bash steamcmd
            fi

            # Create steamcmd folder in home directory of steamcmd user and set ownership
            mkdir -p /home/steamcmd/steamcmd
            chown -R steamcmd:steamcmd /home/steamcmd

            # Check if sudo is installed, if not install it
            if ! dpkg -l | grep -q sudo; then
                apt install -y sudo
            fi

            # Download and extract SteamCMD as the steamcmd user to ensure correct permissions, then run it once to create necessary folders
            sudo -u steamcmd bash -c "cd /home/steamcmd/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
            sudo -u steamcmd bash -c "cd /home/steamcmd/steamcmd && tar -xvzf steamcmd_linux.tar.gz"
            sudo -u steamcmd /home/steamcmd/steamcmd/steamcmd.sh +quit

        fi
    fi

    install_runescape_dragonwilds_dedicated_server=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_runescape_dragonwilds_dedicated_server' | awk -F'=' '{print $2}')
    if [ "$install_runescape_dragonwilds_dedicated_server" == "true" ]; then
        if ! dpkg -l | grep -q runescape-dragonwilds-dedicated-server; then
            
            # Create dragonwilds user if not exists
            if ! id -u dragonwilds >/dev/null 2>&1; then
                useradd -m -s /bin/bash dragonwilds
            fi

            # Create necessary folders for dragonwilds user if not exists
            if [ ! -d "/home/dragonwilds/rs_server" ]; then
                mkdir -p /home/dragonwilds/rs_server
                chown dragonwilds:dragonwilds /home/dragonwilds/rs_server
            fi
            if [ ! -d "/home/dragonwilds/dragonwilds_backups" ]; then
                mkdir -p /home/dragonwilds/dragonwilds_backups
                chown dragonwilds:dragonwilds /home/dragonwilds/dragonwilds_backups
            fi

            # Install SteamCMD if not already installed, but only if the steamcmd.sh file doesn't exist in the expected location.
            if [ ! -f "/home/dragonwilds/steamcmd/steamcmd.sh" ]; then

                # Install required 32-bit libraries for SteamCMD
                if ! dpkg -l | grep -q lib32gcc-s1; then
                    apt install -y lib32gcc-s1
                fi

                # Create steamcmd folder in home directory of dragonwilds user and set ownership
                mkdir -p /home/dragonwilds/steamcmd
                chown -R dragonwilds:dragonwilds /home/dragonwilds

                # Check if sudo is installed, if not install it
                if ! dpkg -l | grep -q sudo; then
                    apt install -y sudo
                fi
                
                # Download and extract SteamCMD as the dragonwilds user to ensure correct permissions, then run it once to create necessary folders
                sudo -u dragonwilds bash -c "cd /home/dragonwilds/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
                sudo -u dragonwilds bash -c "cd /home/dragonwilds/steamcmd && tar -xvzf steamcmd_linux.tar.gz"
                sudo -u dragonwilds /home/dragonwilds/steamcmd/steamcmd.sh +quit

                # Use SteamCMD to download the RuneScape Dragonwilds Dedicated Server files, install them in the correct folder with the correct user permissions
                sudo -u dragonwilds /home/dragonwilds/steamcmd/steamcmd.sh +force_install_dir /home/dragonwilds/rs_server +login anonymous +app_update 4019830 +quit

            fi

            # Create systemd service for RuneScape Dragonwilds Dedicated Server, but only if it doesn't already exist. The service file is selected based on the detected OS and version to ensure compatibility.
            SERVICE_SRC="/opt/vdtg-rmm/systemctl/${OS_ID}/${OS_VER}/runescape-dragonwilds_dedicated-server.service"
            SERVICE_DST="/etc/systemd/system/runescape-dragonwilds_dedicated-server.service"
            if [ -f "$SERVICE_SRC" ]; then
                cp "$SERVICE_SRC" "$SERVICE_DST"
                chown root:root "$SERVICE_DST"
                chmod 644 "$SERVICE_DST"
                systemctl daemon-reload
                systemctl enable runescape-dragonwilds-dedicated-server
                echo "RuneScape Dragonwilds Dedicated Server service installed, please edit /home/dragonwilds/rs_server/RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini to configure the server and then start the service with: systemctl start runescape-dragonwilds-dedicated-server"
            else
                echo "Service file for RuneScape Dragonwilds Dedicated Server not found for OS: $OS_ID version: $OS_VER. Please contact support to add compatibility for your OS version."
            fi

        fi
    fi

    install_eco_dedicated_server=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_eco_dedicated_server' | awk -F'=' '{print $2}')
    if [ "$install_eco_dedicated_server" == "true" ]; then
        if ! dpkg -l | grep -q eco-dedicated-server; then

            # Create eco user if not exists
            if ! id -u eco >/dev/null 2>&1; then
                useradd -m -s /bin/bash eco
            fi

            # Create necessary folders for eco user if not exists
            if [ ! -d "/home/eco/eco_server" ]; then
                mkdir -p /home/eco/eco_server
                chown eco:eco /home/eco/eco_server
            fi

            # Install SteamCMD if not already installed, but only if the steamcmd.sh file doesn't exist in the expected location.
            if [ ! -f "/home/eco/steamcmd/steamcmd.sh" ]; then

                # Install required 32-bit libraries for SteamCMD
                if ! dpkg -l | grep -q lib32gcc-s1; then
                    apt install -y lib32gcc-s1
                fi

                # Create steamcmd folder in home directory of eco user and set ownership
                mkdir -p /home/eco/steamcmd
                chown -R eco:eco /home/eco

                # Check if sudo is installed, if not install it
                if ! dpkg -l | grep -q sudo; then
                    apt install -y sudo
                fi
                
                # Download and extract SteamCMD as the eco user to ensure correct permissions, then run it once to create necessary folders
                sudo -u eco bash -c "cd /home/eco/steamcmd && wget https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
                sudo -u eco bash -c "cd /home/eco/steamcmd && tar -xvzf steamcmd_linux.tar.gz"
                sudo -u eco /home/eco/steamcmd/steamcmd.sh +quit

                # Use SteamCMD to download the ECO Dedicated Server files, install them in the correct folder with the correct user permissions
                sudo -u eco /home/eco/steamcmd/steamcmd.sh +force_install_dir /home/eco/eco_server +login anonymous +app_update 739590 -beta default validate +quit

            fi

            # Create systemd service for ECO Dedicated Server, but only if it doesn't already exist. The service file is selected based on the detected OS and version to ensure compatibility.
            SERVICE_SRC="/opt/vdtg-rmm/systemctl/${OS_ID}/${OS_VER}/eco-dedicated-server.service"
            SERVICE_DST="/etc/systemd/system/eco-dedicated-server.service"
            if [ -f "$SERVICE_SRC" ]; then
                cp "$SERVICE_SRC" "$SERVICE_DST"
                chown root:root "$SERVICE_DST"
                chmod 644 "$SERVICE_DST"
                systemctl daemon-reload
                systemctl enable eco-dedicated-server
                echo "ECO Dedicated Server service installed, please edit /home/eco/eco_server/Configs/* to configure the server and then start the service with: systemctl start eco-dedicated-server"

                # Inject userToken direct in ExecStart als deze in de config staat
                eco_userToken=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i '^eco_dedicated_server_userToken=' | awk -F'=' '{print $2}')
                if [ -n "$eco_userToken" ]; then
                    # Escape special characters for sed
                    escaped_token=$(printf '%s\n' "$eco_userToken" | sed -e 's/[\/&]/\\&/g')
                    sed -i "s|^ExecStart=/home/eco/eco_server/EcoServer.*|ExecStart=/home/eco/eco_server/EcoServer -userToken=$escaped_token|" "$SERVICE_DST"
                fi
            fi

            # Install required libgdiplus for ECO Dedicated Server
            if ! dpkg -l | grep -q libgdiplus; then
                apt install -y libgdiplus
            fi

        fi
    fi

    install_zoho_assist_remote_support=$(grep -v '^#' /opt/vdtg-rmm/vdtg-rmm.config | grep -i 'install_zoho_assist_remote_support' | awk -F'=' '{print $2}')
    if [ "$install_zoho_assist_remote_support" == "true" ]; then
        if [ ! -f "/usr/share/applications/zoho-assist.desktop" ]; then

            # Create applications folder if it doesn't exist
            if [ ! -d "/opt/vdtg-rmm/applications" ]; then
                mkdir -p /opt/vdtg-rmm/applications
            fi

            # Install dependencies for Zoho Assist Remote Support
            apt install wget fuse -y

            # Download and install Zoho Assist Remote Support
            wget -O /opt/vdtg-rmm/applications/ZohoAssist.AppImage https://downloads.zohocdn.com/assist-desktop/zoho-assist-desktop-x64.AppImage

            # Make the AppImage executable
            chmod +x /opt/vdtg-rmm/applications/ZohoAssist.AppImage

            # Create desktop entry for Zoho Assist Remote Support
            cp /opt/vdtg-rmm/applications/zoho-assist.desktop /usr/share/applications/zoho-assist.desktop
            chown root:root /usr/share/applications/zoho-assist.desktop
            chmod 644 /usr/share/applications/zoho-assist.desktop
            
            # Update the desktop database to recognize the new application
            update-desktop-database

        fi
    fi

else
    echo "Application not installed at /opt/vdtg-rmm. Please install application in the correct folder."
    exit
fi