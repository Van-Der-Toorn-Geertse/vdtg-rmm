[Unit]
Description=RuneScape Dragonwilds Dedicated Server
# Start pas als netwerk online is
Wants=network-online.target
# Start na netwerk
After=network-online.target

[Service]
# Simpel proces, geen forking
Type=simple
# Draai als gebruiker dragonwilds
User=dragonwilds
# Draai in groep dragonwilds
Group=dragonwilds

# Werkdirectory voor de service
WorkingDirectory=/home/dragonwilds/rs_server

# Update de server via SteamCMD
ExecStartPre=/home/dragonwilds/steamcmd/steamcmd.sh +force_install_dir /home/dragonwilds/rs_server +login anonymous +app_update 4019830 +quit

# Zorg dat het startscript uitvoerbaar is
ExecStartPre=/bin/bash -c "chmod +x /home/dragonwilds/rs_server/RSDragonwildsServer.sh"

# Start de dedicated server met logging en poort 7777
ExecStart=/home/dragonwilds/rs_server/RSDragonwildsServer.sh -log -NewConsole -Port=7777

# Herstart altijd bij falen, wacht 15 seconden
Restart=always
RestartSec=15

# ---[Install]---
[Install]
# Start automatisch in multi-user mode
WantedBy=multi-user.target